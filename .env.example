# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Google Maps ---------------------------------------------------------
# Reuse the SAME key from the original Lovable build (it already depended on
# @react-google-maps/api). In Google Cloud Console, make sure this key has:
#   Maps JavaScript API, Places API, Geocoding API, Directions API
VITE_GOOGLE_MAPS_API_KEY=

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
